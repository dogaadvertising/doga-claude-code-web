{
  "$description": "DOGA Construction Design System. Fuente única de tokens (formato W3C Design Tokens). Generar tokens.css y tailwind.preset.js con `npm run build:tokens`. No editar los archivos generados a mano.",
  "color": {
    "$type": "color",
    "blue":   { "$value": "#19263C", "$description": "DOGA Blue. Fondo primario dominante." },
    "yellow": { "$value": "#FFB000", "$description": "DOGA Yellow. Acento primario, CTAs, titulares sobre oscuro." },
    "grey":   { "$value": "#F1F1F1", "$description": "DOGA Grey. Fondo secundario en modo claro." },
    "black":  { "$value": "#0C0C0C", "$description": "Negro de marca. Nunca #000000." },
    "white":  { "$value": "#FFFFFF", "$description": "Texto sobre oscuro. Logo sobre azul o amarillo." },
    "slate":  { "$value": "#4D5A6A", "$description": "Neutro de apoyo. Texto secundario sobre claro." },
    "gray":   { "$value": "#9E9B98", "$description": "Neutro de apoyo. Captions sobre oscuro." },
    "olive": {
      "$value": "#000000",
      "$description": "TODO(DOGA): confirmar HEX. Acento. No usar aún.",
      "$extensions": { "doga": { "status": "pending", "note": "Placeholder de la spec. El build NO lo emite como color: publica --doga-olive con valor `initial` para que cualquier uso accidental quede sin color." } }
    },
    "error": {
      "$value": "#C62828",
      "$description": "TODO(DOGA): definir color de error. Valor sugerido por la spec. 5.62:1 sobre white (OK), 2.70:1 sobre blue (falla AA).",
      "$extensions": { "doga": { "status": "suggested" } }
    },
    "blue-700": {
      "$value": "#172235",
      "$description": "blue mezclado 15% con black. Hover de superficies oscuras y --bg-secondary oscuro.",
      "$extensions": { "doga": { "mix": { "base": "blue", "with": "black", "amount": 0.15 } } }
    },
    "blue-500": {
      "$value": "#475163",
      "$description": "blue mezclado 20% con white. Bordes sobre fondo azul.",
      "$extensions": { "doga": { "mix": { "base": "blue", "with": "white", "amount": 0.2 } } }
    },
    "yellow-600": {
      "$value": "#E29C01",
      "$description": "yellow mezclado 12% con black. Hover de botón primario.",
      "$extensions": { "doga": { "mix": { "base": "yellow", "with": "black", "amount": 0.12 } } }
    },
    "grey-300": {
      "$value": "#DADADA",
      "$description": "grey mezclado 10% con black. Bordes en modo claro.",
      "$extensions": { "doga": { "mix": { "base": "grey", "with": "black", "amount": 0.1 } } }
    }
  },

  "semantic": {
    "$description": "Tokens que usan los componentes. dark es el default de marca (:root). light se activa con [data-theme=\"light\"].",
    "dark": {
      "$type": "color",
      "bg-primary":     { "$value": "{color.blue}" },
      "bg-secondary":   { "$value": "{color.blue-700}" },
      "bg-accent":      { "$value": "{color.yellow}" },
      "text-primary":   { "$value": "{color.white}" },
      "text-secondary": { "$value": "{color.grey}" },
      "text-muted":     { "$value": "{color.gray}" },
      "text-headline":  { "$value": "{color.yellow}" },
      "text-on-accent": { "$value": "{color.blue}" },
      "border-default": { "$value": "{color.blue-500}" },
      "border-accent":  { "$value": "{color.yellow}" },
      "cta-bg":         { "$value": "{color.yellow}" },
      "cta-text":       { "$value": "{color.blue}" },
      "cta-bg-hover":   { "$value": "{color.yellow-600}" },
      "focus-ring":     { "$value": "{color.yellow}", "$description": "Sección 6.5. Outline amarillo sobre oscuro." },
      "text-error":     { "$value": "{color.white}", "$description": "TODO(DOGA): no existe un rojo de marca con 4.5:1 sobre blue. Opción sobria: mensaje en --text-primary, marcado por borde e icono de error." },
      "border-error":   { "$value": "{color.error}", "$description": "TODO(DOGA): 2.70:1 sobre blue, bajo el 3:1 de WCAG 1.4.11. Pendiente de color de error definitivo." }
    },
    "light": {
      "$type": "color",
      "bg-primary":     { "$value": "{color.white}" },
      "bg-secondary":   { "$value": "{color.grey}" },
      "bg-accent":      { "$value": "{color.yellow}" },
      "text-primary":   { "$value": "{color.black}" },
      "text-secondary": { "$value": "{color.slate}" },
      "text-muted":     { "$value": "{color.slate}" },
      "text-headline":  { "$value": "{color.blue}" },
      "text-on-accent": { "$value": "{color.blue}" },
      "border-default": { "$value": "{color.grey-300}" },
      "border-accent":  { "$value": "{color.yellow}" },
      "cta-bg":         { "$value": "{color.yellow}" },
      "cta-text":       { "$value": "{color.blue}" },
      "cta-bg-hover":   { "$value": "{color.yellow-600}" },
      "focus-ring":     { "$value": "{color.blue}", "$description": "Sección 6.5. Outline azul sobre claro." },
      "text-error":     { "$value": "{color.error}", "$description": "5.62:1 sobre white, 4.98:1 sobre grey." },
      "border-error":   { "$value": "{color.error}" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display":    { "$value": ["Montserrat", "system-ui", "sans-serif"], "$description": "Titulares. Pesos 900 y 700. Siempre mayúsculas vía CSS." },
      "body":       { "$value": ["Montserrat", "system-ui", "sans-serif"], "$description": "Párrafos, UI, formularios. Pesos 400, 500, 600." },
      "expressive": { "$value": ["Trash Hand", "Montserrat", "system-ui", "sans-serif"], "$description": "Solo momentos manuscritos puntuales. Nunca cuerpo ni botones. TODO(DOGA): subir archivo de fuente con licencia." },
      "email":      { "$value": ["Montserrat", "Arial", "sans-serif"], "$description": "Email. Montserrat con fallback Arial (sección 9.14)." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 900 }
    }
  },

  "type": {
    "$description": "Escala tipográfica web (sección 5.2).",
    "hero":    { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(2.5rem, 6vw, 5rem)",     "fontWeight": "{font.weight.black}",    "lineHeight": 1.0, "letterSpacing": "-0.01em", "textTransform": "uppercase" } },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(2rem, 4vw, 3rem)",       "fontWeight": "{font.weight.bold}",     "lineHeight": 1.1, "letterSpacing": "0",       "textTransform": "uppercase" } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(1.5rem, 2.5vw, 1.75rem)", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.2, "letterSpacing": "0",       "textTransform": "none" }, "$description": "Subsecciones y callouts. Peso 600 (fuera de los pesos display 900/700), por eso no se fuerza mayúscula. TODO(DOGA): confirmar si h2 debe ir en mayúsculas." },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}",    "fontSize": "1.125rem",                     "fontWeight": "{font.weight.regular}",  "lineHeight": 1.6, "letterSpacing": "0",       "textTransform": "none" } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}",    "fontSize": "1rem",                         "fontWeight": "{font.weight.regular}",  "lineHeight": 1.6, "letterSpacing": "0",       "textTransform": "none" } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.family.body}",    "fontSize": "0.75rem",                      "fontWeight": "{font.weight.medium}",   "lineHeight": 1.4, "letterSpacing": "0.08em",  "textTransform": "none" }, "$description": "Captions y fine print. Mayúsculas solo cuando actúa como label (utilidad uppercase)." },
    "eyebrow": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}",    "fontSize": "0.8125rem",                    "fontWeight": "{font.weight.bold}",     "lineHeight": 1.2, "letterSpacing": "0.12em",  "textTransform": "uppercase" } }
  },

  "space": {
    "$type": "dimension",
    "$description": "Base 4px.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "6px",  "$description": "Inputs, chips pequeños, tags." },
    "md":   { "$value": "12px", "$description": "Cards, contenedores, imágenes." },
    "pill": { "$value": "20px", "$description": "Pills, badges." },
    "btn":  { "$value": "6px",  "$description": "Botones. Sólidos y estructurados, no redondeados." }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "default": { "$value": "1px",   "$description": "Borde default con --border-default." },
      "accent":  { "$value": "2px",   "$description": "Cards destacadas, marcos de señalética, foco, botones secondary/ghost." },
      "motif":   { "$value": "1.5px", "$description": "Línea del patrón chevron / escalonado. Rango de la spec 1 a 1.5px. Solo línea, nunca relleno." },
      "rule":    { "$value": "4px",   "$description": "Línea amarilla al pie del EmailHeader (sección 9.14)." }
    }
  },

  "shadow": {
    "$type": "shadow",
    "overlay": { "$value": "0 8px 24px rgba(12,12,12,0.35)", "$description": "Única sombra permitida. Modales y menús flotantes." }
  },

  "focus": {
    "outline-width":  { "$type": "dimension", "$value": "2px" },
    "outline-offset": { "$type": "dimension", "$value": "2px" }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "480px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },

  "layout": {
    "container": { "$type": "dimension", "$value": "1200px", "$description": "Contenedor máximo." },
    "measure":   { "$type": "dimension", "$value": "68ch",   "$description": "Ancho máximo de texto largo." },
    "gutter-mobile":  { "$type": "dimension", "$value": "16px", "$description": "Gutter móvil y padding lateral mínimo." },
    "gutter-tablet":  { "$type": "dimension", "$value": "24px" },
    "gutter-desktop": { "$type": "dimension", "$value": "32px" },
    "columns-mobile":  { "$type": "number", "$value": 4 },
    "columns-tablet":  { "$type": "number", "$value": 8 },
    "columns-desktop": { "$type": "number", "$value": 12 },
    "section-gap-mobile":  { "$type": "dimension", "$value": "{space.8}", "$description": "64px entre secciones en móvil." },
    "section-gap-desktop": { "$type": "dimension", "$value": "{space.9}", "$description": "96px entre secciones en desktop." }
  },

  "size": {
    "$type": "dimension",
    "$description": "Alturas y medidas fijas de componentes que la spec define explícitamente.",
    "touch-min":  { "$value": "48px",   "$description": "Mínimo táctil. Button md, input." },
    "btn-lg":     { "$value": "56px",   "$description": "Button lg, CTA de landing." },
    "sticky-bar": { "$value": "64px",   "$description": "PhoneCTA sticky móvil." },
    "email":      { "$value": "600px",  "$description": "Ancho de EmailHeader." },
    "ad-width":   { "$value": "1080px", "$description": "Ancho nativo AdFrame." },
    "ad-height-square": { "$value": "1080px", "$description": "AdFrame 1:1." },
    "ad-height-story":  { "$value": "1920px", "$description": "AdFrame 9:16." },
    "ad-safe-top":      { "$value": "250px",  "$description": "Zona segura 9:16, arriba (UI de Reels/Stories)." },
    "ad-safe-bottom":   { "$value": "340px",  "$description": "Zona segura 9:16, abajo." }
  },

  "opacity": {
    "$type": "number",
    "hero-overlay": { "$value": 0.8, "$description": "Overlay blue al 80% sobre foto en Hero." }
  }
}
